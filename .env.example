# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

# Optional client map tile URL. Defaults to OpenStreetMap standard tiles.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# MySQL (used by server/src/config/db.js)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agrisystem

# Production crop / fruit / vegetable photo analysis (Gemini Vision).
# This file belongs in the project root as .env (beside this .env.example file).
# Create your own key in Google AI Studio, keep it only in .env, and never expose it in client code.
# The system will show a setup message instead of guessing when this is empty.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash
# Gemini 3 models support low, medium, or high thinking. Low keeps interactive crop scans responsive.
GEMINI_THINKING_LEVEL=low
# Concise structured crop result. Keep this between 800 and 1800.
GEMINI_MAX_OUTPUT_TOKENS=1200
# Used only if the primary Gemini model is busy or rate-limited.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
OPENWEATHER_API_KEY=

# Philippine SMS password-reset OTPs and staff alerts (Semaphore).
# Set this only in the private root .env file. Sender names must be approved in Semaphore.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Gmail sender for email password recovery and farmer notices. Use a Gmail App Password, never your normal password.
GMAIL_USER=mao.example@gmail.com
GMAIL_APP_PASSWORD=

# Google Sign-In Web OAuth client ID (created in Google Cloud Console)
GOOGLE_CLIENT_ID=
